---
import BaseLayout from '../layouts/BaseLayout.astro';

const services = [
  {
    icon: '🎯',
    title: 'SEO & SEM Strategy',
    shortDesc: 'Tingkatkan visibilitas online Anda dengan strategi SEO dan SEM yang terukur dan berbasis data untuk pertumbuhan bisnis yang berkelanjutan.',
    details: [
      'Audit Teknis Website & Core Web Vitals',
      'Riset Keyword Kompetitif & Intent-based',
      'Optimasi On-Page & Off-Page (Link Building)',
      'Manajemen Kampanye Google Ads (Search, Display, Shopping)',
      'Laporan Performa Bulanan berbasis Data (ROI & Conversion)'
    ]
  },
  {
    icon: '🚀',
    title: 'Digital Marketing',
    shortDesc: 'Kampanye digital yang komprehensif meliputi social media, content marketing, dan paid advertising untuk menjangkau audiens yang tepat.',
    details: [
      'Perencanaan Strategi Konten & Kalender Editorial',
      'Manajemen Media Sosial (Instagram, LinkedIn, TikTok)',
      'Iklan Berbayar (Meta Ads, TikTok Ads, LinkedIn Ads)',
      'Email Marketing & Automation Funnel',
      'Analisis Audiens & Optimasi Biaya per Akuisisi (CPA)'
    ]
  },
  {
    icon: '💻',
    title: 'Web Development',
    shortDesc: 'Website modern dengan arsitektur headless CMS, performa tinggi, dan SEO-friendly menggunakan teknologi terkini.',
    details: [
      'Desain UI/UX yang Responsif & User-Friendly',
      'Implementasi Headless CMS (WordPress + Astro/Next.js)',
      'Optimasi Kecepatan Loading (Skor 90+ di PageSpeed Insights)',
      'Integrasi API, CRM, dan Tools Analitik',
      'Pemeliharaan, Keamanan, dan Update Berkala'
    ]
  }
];

const processSteps = [
  {
    step: '01',
    title: 'Konsultasi & Audit',
    desc: 'Kami menganalisis kondisi bisnis dan digital presence Anda saat ini untuk menemukan peluang terbesar.'
  },
  {
    step: '02',
    title: 'Strategi & Perencanaan',
    desc: 'Menyusun roadmap yang terukur, termasuk KPI, timeline, dan alokasi anggaran yang efisien.'
  },
  {
    step: '03',
    title: 'Eksekusi & Implementasi',
    desc: 'Tim kami menjalankan strategi dengan presisi, memastikan setiap detail teknis dan kreatif terkelola dengan baik.'
  },
  {
    step: '04',
    title: 'Evaluasi & Optimasi',
    desc: 'Memantau performa secara real-time dan melakukan penyesuaian berkelanjutan untuk memaksimalkan hasil.'
  }
];
---

<BaseLayout title="Layanan" description="Layanan profesional Digital Marketing, SEO, SEM, dan Web Development untuk pertumbuhan bisnis Anda.">
  
  <!-- Hero Section -->
  <section class="bg-emerald-900 py-20 lg:py-28">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-4 py-2 bg-lime-400 rounded-full mb-6">
        <span class="w-2 h-2 bg-emerald-900 rounded-full animate-pulse"></span>
        <span class="text-sm font-semibold text-emerald-900">Solusi Digital Terintegrasi</span>
      </div>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight">
        Akselerasi Bisnis Anda dengan <span class="text-lime-400">Strategi Digital</span>
      </h1>
      <p class="text-lg text-emerald-100 max-w-3xl mx-auto">
        Kami menggabungkan keahlian teknis dan pemahaman pemasaran untuk memberikan solusi yang tidak hanya terlihat bagus, tetapi juga menghasilkan konversi nyata.
      </p>
    </div>
  </section>

  <!-- Services Detail Section -->
  <section class="py-20 bg-gray-50" id="services">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-emerald-900 mb-4">Layanan Profesional Kami</h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          Setiap layanan dirancang untuk saling melengkapi, menciptakan ekosistem digital yang kuat untuk bisnis Anda.
        </p>
      </div>

      <div class="space-y-12">
        {services.map((service) => (
          <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-lg transition duration-300">
            <div class="grid lg:grid-cols-3 gap-0">
              {/* Left: Icon & Title */}
              <div class="bg-emerald-900 p-8 lg:p-10 flex flex-col justify-center text-white">
                <div class="text-5xl mb-4">{service.icon}</div>
                <h3 class="text-2xl font-bold mb-3">{service.title}</h3>
                <p class="text-emerald-100 leading-relaxed">{service.shortDesc}</p>
              </div>
              
              {/* Right: Details List */}
              <div class="lg:col-span-2 p-8 lg:p-10">
                <h4 class="text-sm font-bold text-gray-400 uppercase tracking-wider mb-6">Apa yang Anda Dapatkan:</h4>
                <ul class="grid md:grid-cols-2 gap-4">
                  {service.details.map((detail) => (
                    <li class="flex items-start gap-3">
                      <svg class="w-6 h-6 text-lime-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                      </svg>
                      <span class="text-gray-700 font-medium">{detail}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How It Works Section -->
  <section class="py-20 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-emerald-900 mb-4">Metodologi Kerja Kami</h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          Pendekatan terstruktur untuk memastikan transparansi dan hasil yang terukur di setiap tahapan.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        {processSteps.map((item, index) => (
          <div class="relative">
            {/* Connector Line (Desktop only) */}
            {index < processSteps.length - 1 && (
              <div class="hidden lg:block absolute top-8 left-1/2 w-full h-0.5 bg-emerald-100 -z-10"></div>
            )}
            
            <div class="bg-gray-50 rounded-xl p-6 border border-gray-100 text-center hover:border-lime-400 transition duration-300">
              <div class="w-16 h-16 bg-emerald-900 text-lime-400 font-bold text-xl rounded-full flex items-center justify-center mx-auto mb-4 shadow-md">
                {item.step}
              </div>
              <h3 class="text-xl font-bold text-gray-900 mb-2">{item.title}</h3>
              <p class="text-gray-600 text-sm leading-relaxed">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 bg-lime-400">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-emerald-900 mb-6">
        Siap Memulai Transformasi Digital Bisnis Anda?
      </h2>
      <p class="text-xl text-emerald-800 mb-8">
        Jadwalkan sesi konsultasi gratis selama 30 menit untuk mendiskusikan kebutuhan spesifik bisnis Anda.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a 
          href="https://wa.me/6285888888465" 
          target="_blank"
          class="px-8 py-4 bg-emerald-900 text-white font-semibold rounded-lg hover:bg-emerald-800 transition shadow-lg flex items-center justify-center gap-2"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
          Konsultasi Gratis via WhatsApp
        </a>
        <a 
          href="/portfolio" 
          class="px-8 py-4 bg-white text-emerald-900 font-semibold rounded-lg hover:bg-gray-100 transition border-2 border-emerald-900"
        >
          Lihat Portofolio Kami
        </a>
      </div>
    </div>
  </section>

</BaseLayout>