---
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = [
  {
    title: 'Headless WordPress Architecture',
    description: 'Implementasi arsitektur headless WordPress dengan Astro frontend dan GraphQL API untuk performa optimal dan SEO yang sempurna.',
    tags: ['WordPress', 'Astro', 'GraphQL', 'Headless CMS'],
    image: 'https://api.wahanadigital.com/wp-content/uploads/2026/07/Headless.webp',
    link: '#'
  },
  {
    title: 'SEO & SEM Campaign',
    description: 'Strategi komprehensif SEO dan SEM yang meningkatkan traffic organik 300% dan ROAS 5x dalam 6 bulan.',
    tags: ['SEO', 'SEM', 'Google Ads', 'Analytics'],
    image: 'https://api.wahanadigital.com/wp-content/uploads/2026/07/SEO-SEM-Campaign.webp',
    link: '#'
  },
  {
    title: 'E-Commerce Digital Transformation',
    description: 'Transformasi digital untuk bisnis retail dengan integrasi payment gateway, inventory management, dan marketing automation.',
    tags: ['E-Commerce', 'Digital Strategy', 'Automation'],
    image: 'https://api.wahanadigital.com/wp-content/uploads/2026/07/E-Commerce-Digital-Transformation.webp',
    link: '#'
  }
];

const clientSites = [
  'ob-fit.com',
  'MULTIMEDIALASER.COM',
  'MMPADV.COM',
  'MULIACAHAYALASER.COM',
  'MULIACAHAYABENDING.COM',
  'MULIACAHAYABENDINGs.COM',
  'dhinarrgenteng.com',
  'pusatgentengmurahterbaik.com',
  'gudangatapjateng.com',
  'bursamegaatap.com',
  'themeathouseid.com',
  'rubymarmer.com',
  'terminalatapmandiri.com'
].map((domain) => {
  const clean = domain.replace(/^https?:\/\//i, '').replace(/\/$/, '');
  return {
    domain: clean,
    url: `https://${clean}`
  };
});
---

<BaseLayout title="Portofolio">
  <div class="max-w-6xl mx-auto px-4 py-16">
    <!-- Header -->
    <div class="text-center mb-12">
      <h1 class="text-4xl font-bold text-gray-900 mb-4">Portofolio</h1>
      <p class="text-xl text-gray-600">Beberapa project dan pencapaian yang telah saya kerjakan</p>
    </div>

    <!-- Projects Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {projects.map((project) => (
        <article class="bg-white rounded-xl shadow-sm overflow-hidden hover:shadow-lg transition">
          <img src={project.image} alt={project.title} class="w-full h-48 object-cover" />
          <div class="p-6">
            <h3 class="text-xl font-bold text-gray-900 mb-2">{project.title}</h3>
            <p class="text-gray-600 text-sm mb-4">{project.description}</p>
            <div class="flex flex-wrap gap-2 mb-4">
              {project.tags.map((tag) => (
                <span class="px-3 py-1 bg-blue-100 text-blue-700 text-xs font-medium rounded-full">
                  {tag}
                </span>
              ))}
            </div>
            <a href={project.link} class="text-blue-600 font-medium hover:underline text-sm">
              Lihat Detail &rarr;
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- Client Websites -->
    <div class="mt-20">
      <div class="text-center mb-10">
        <h2 class="text-3xl font-bold text-emerald-900 mb-3">Website Klien</h2>
        <p class="text-lg text-gray-600">Kumpulan website yang telah dibangun dan dikembangkan</p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        {clientSites.map((site) => (
          <a
            href={site.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center justify-between gap-2 bg-white border border-gray-200 rounded-xl px-5 py-4 shadow-sm hover:shadow-lg hover:border-emerald-400 transition"
          >
            <span class="font-semibold text-gray-800 text-sm truncate group-hover:text-emerald-700 transition">
              {site.domain}
            </span>
            <svg class="w-4 h-4 flex-shrink-0 text-emerald-600 opacity-0 group-hover:opacity-100 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
            </svg>
          </a>
        ))}
      </div>
    </div>

    <!-- CTA -->
    <div class="text-center mt-12">
      <p class="text-gray-600 mb-4">Tertarik bekerja sama?</p>
      <a href="/contact" class="inline-block px-6 py-3 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 transition">
        Hubungi Saya
      </a>
    </div>
  </div>
</BaseLayout>